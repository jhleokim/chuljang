{
  "manifest_version": 3,
  "name": "출장 영수증 수집",
  "version": "1.0.0",
  "description": "현재 열린 영수증 페이지의 텍스트를 검토한 뒤 내 출장 공간으로 보냅니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chuljang-receipts.jhleokim.chatgpt.site/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
