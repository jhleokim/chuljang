# 로그인 세션 서명 키. 배포 환경에서는 반드시 설정한다. 예: openssl rand -base64 48
CHULJANG_AUTH_SECRET=
# 배포 환경 로그인에 필요한 접속 코드. 로컬(localhost)에서는 없어도 로그인할 수 있다.
CHULJANG_ACCESS_CODE=
# 선택: 로그인 가능한 이메일 목록. 비워 두면 접속 코드를 아는 모든 이메일이 로그인할 수 있다.
CHULJANG_ALLOWED_EMAILS=
# 선택: 기존 배포의 사용자 ID를 이어받기 위한 별칭. 예: me@example.com=user_abc123
CHULJANG_USER_ALIASES=
# 선택: 앱을 다른 도메인에서도 제공할 때 허용할 출처 목록.
CHULJANG_APP_ORIGINS=
# 선택: 기존 ChatGPT Sites 배포를 그대로 유지할 때만 1로 설정한다.
CHULJANG_TRUST_PLATFORM_AUTH=
# 수집 서버 연결.
CHULJANG_COLLECTOR_URL=https://chuljang-collector.hanatrust.workers.dev
CHULJANG_COLLECTOR_SECRET=
